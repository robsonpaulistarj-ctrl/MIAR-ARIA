# Backend
PORT=8080
NODE_ENV=development
# Deixe vazio para testar em modo memória; preencha com a URL real para persistência.
DATABASE_URL=
WEB_ORIGIN=http://localhost:5173
# Token partilhado usado apenas pelo login privado de staging.
MIAR_ACCESS_TOKEN=troque-este-token

# Storage de anexos: local no desenvolvimento; s3 em produção.
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
AI_MAX_IMAGE_BYTES=10485760

# IA compatível com OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Use demo para validar o fluxo sem consumir um provedor externo.
AI_MODE=demo

# Frontend
VITE_API_URL=/api
VITE_DEV_USER_EMAIL=dev@miar.local
VITE_AUTH_REQUIRED=false
# Apenas para o proxy Vite local.
API_URL=http://localhost:8080
